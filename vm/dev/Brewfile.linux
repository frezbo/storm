# Linux subset of ~/.Brewfile for the storm-dev VM. GNU userland, make,
# gcc, git, diffoscope and debug tools come from Fedora (vm/dev/user-data);
# Mac-only and desktop formulae (pinentry-mac, touch-to-sign, assh, ffmpeg,
# qemu, swtpm, topgrade, letta-code) are left out.
tap "siderolabs/tap"

brew "age"
brew "awscli"
brew "bat"
brew "chezmoi"
brew "cosign"
brew "crane"
brew "crit"
brew "direnv"
brew "docker"
brew "docker-buildx"
brew "eza"
brew "flyctl"
brew "gh"
brew "go"
brew "golangci-lint"
brew "gopls"
brew "graphviz"
brew "helix"
brew "helm"
brew "jq"
brew "kubelogin"
brew "kubernetes-cli"
brew "kubie"
brew "node"
# Homebrew refuses untrusted taps: run `brew trust --formula siderolabs/tap/omnictl` once.
brew "siderolabs/tap/omnictl"
brew "ripgrep"
brew "socat"
brew "sops"
brew "starship"
brew "stern"
brew "talosctl"
brew "terraform-docs"
brew "topgrade"
brew "tree"
brew "typst"
brew "worktrunk"
brew "yq"

cask "claude-code"
